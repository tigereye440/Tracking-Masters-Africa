generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model ContactLead {
  id        String    @id @default(cuid())
  name      String
  phone     String
  service   String?
  message   String
  createdAt DateTime  @default(now())
}

enum TestimonialStatus { 
  PENDING
  APPROVED
  REJECTED
}


model Testimonial {
  id          String             @id @default(cuid())
  quote       String
  serviceSlug String
  location    String
  rating      Int
  status      TestimonialStatus  @default(PENDING)
  createdAt   DateTime           @default(now())
}



enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  body        String
  serviceSlug String
  imageUrl    String?
  readTime    String
  status      PostStatus   @default(DRAFT) 
  createdAt   DateTime     @default(now())
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String    
  serviceSlug String
  summary     String
  imageUrl    String?
  status      ContentStatus   @default(DRAFT)
  createdAt   DateTime        @default(now())

}




model Faq {
  id        String        @id @default(cuid())
  question  String  
  answer    String
  category  String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
}